# Database
DB_USER=monitora
DB_PASSWORD=monitora123
DB_NAME=monitora_to
DB_PORT=5432
DATABASE_URL=postgresql://monitora:monitora123@postgres:5432/monitora_to

# Redis
REDIS_URL=redis://redis:6379

# API
API_PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Uploads
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=10485760

# Sync (optional)
# Por padrao, o backend usa fontes RSS de obras publicas (municipais, estaduais e federais)
# para cidades do Tocantins.
# Se quiser sobrescrever, informe uma lista de URLs separadas por virgula.
# OBRA_SYNC_SOURCES=https://news.google.com/rss/search?q=obras+publicas+Araguaina+TO&hl=pt-BR&gl=BR&ceid=BR:pt-419,https://news.google.com/rss/search?q=prefeitura+Gurupi+obras+TO&hl=pt-BR&gl=BR&ceid=BR:pt-419
