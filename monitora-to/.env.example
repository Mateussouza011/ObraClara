# Variáveis usadas pelo docker-compose.yml (pasta monitora-to/)
#
# Para sobrescrever no seu ambiente local:
#   cp .env.example .env
#

# Porta publicada no host para acessar a API (o container continua ouvindo em 3000)
HOST_API_PORT=3000

# Porta publicada no host para Redis
REDIS_PORT=6379

# Porta publicada no host para Postgres
DB_PORT=5432

# Credenciais do Postgres (dev)
DB_USER=monitora
DB_PASSWORD=monitora123
DB_NAME=monitora_to

# Outros
NODE_ENV=development
JWT_SECRET=your-secret-key-change-in-production
